# Copia este archivo a .env y completa los valores.

# URL base del backend (API v1).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api/v1

# DSN de Sentry para crash reporting. Si se deja vacio, el init de Sentry
# es un no-op (no rompe la app, simplemente no reporta errores).
# Crea una cuenta/proyecto en https://sentry.io y pega el DSN aca.
EXPO_PUBLIC_SENTRY_DSN=
